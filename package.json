{
  "name": "pi-devflow",
  "version": "0.1.0",
  "description": "A lightweight, extensible development workflow package for Pi.",
  "type": "module",
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./dsh": "./dsh/index.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "xuzhen97",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuzhen97/pi-devflow.git"
  },
  "homepage": "https://github.com/xuzhen97/pi-devflow#readme",
  "bugs": {
    "url": "https://github.com/xuzhen97/pi-devflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "developer-tools",
    "workflow"
  ],
  "files": [
    "dsh/",
    "extensions/",
    "skills/",
    "docs/adr/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "postinstall": "node ./dsh/install.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "typescript": "^5.9.3"
  }
}
